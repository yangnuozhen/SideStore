+
+// Preserve the original protocol witnesses while platform-aware overloads serve Watch targets.
+public extension DeveloperPortal {
+    func fetchAppIDs(for team: Team, session: Session) async throws -> [AppID] {
+        try await fetchAppIDs(for: team, deviceType: .iPhone, session: session)
+    }
+    func addAppID(withName name: String, bundleIdentifier: String, team: Team, session: Session) async throws -> AppID {
+        try await addAppID(withName: name, bundleIdentifier: bundleIdentifier, deviceType: .iPhone, team: team, session: session)
+    }
+    func updateAppID(_ appID: AppID, team: Team, session: Session) async throws -> AppID {
+        try await updateAppID(appID, deviceType: .iPhone, team: team, session: session)
+    }
+    func fetchAppGroups(for team: Team, session: Session) async throws -> [AppGroup] {
+        try await fetchAppGroups(for: team, deviceType: .iPhone, session: session)
+    }
+    func addAppGroup(name: String, groupIdentifier: String, team: Team, session: Session) async throws -> AppGroup {
+        try await addAppGroup(name: name, groupIdentifier: groupIdentifier, deviceType: .iPhone, team: team, session: session)
+    }
+    func assignAppGroups(_ appGroups: [AppGroup], to appID: AppID, team: Team, session: Session) async throws -> AppID {
+        try await assignAppGroups(appGroups, to: appID, deviceType: .iPhone, team: team, session: session)
+    }
+}
